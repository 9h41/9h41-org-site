<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include "partials/head.njk" %}
    <style>
      html, body { margin: 0; padding: 0; background: #fff; }
      .wix-frame {
        width: 100vw;
        height: 2200px;
        border: 0;
        display: block;
      }
      @media (max-width: 760px) {
        .wix-frame { height: 2400px; }
      }
    </style>
  </head>
  <body>
    <iframe
      class="wix-frame"
      src="{{ mirrorUrl }}"
      loading="eager"
      referrerpolicy="no-referrer-when-downgrade"
      title="{{ title }}"
    ></iframe>
  </body>
</html>
