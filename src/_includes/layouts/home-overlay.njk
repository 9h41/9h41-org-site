<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include "partials/head.njk" %}
    <style>
      html, body { margin: 0; padding: 0; background: #f2f2f2; }
      .home-overlay-root { position: relative; width: 100%; }
      .home-base { width: 100%; height: auto; display: block; }
      .home-base.mobile { display: none; }

      .industries-overlay {
        position: absolute;
        left: 0;
        right: 0;
        top: 2961px;
        height: 1739px;
        background: transparent;
        overflow: visible;
      }

      .industries-grid {
        position: relative;
        width: 100%;
        height: 100%;
      }

      .industries-intro-art {
        position: absolute;
        left: 23px;
        top: 0;
        width: 558px;
        height: 1716px;
      }
      .industries-intro-art.mobile { display: none; }
      .industries-intro-art img { width: 100%; height: 100%; display: block; }

      .stack-track {
        position: absolute;
        left: 580px;
        top: 154px;
        width: 797px;
        height: calc(100% - 154px);
      }

      .stack-card {
        position: sticky;
        top: 142px;
        margin-top: var(--step-d, 0px);
        width: var(--w-d, 797px);
        height: var(--h-d, 440px);
        z-index: calc(30 - var(--i, 0));
      }

      .card-art { width: 100%; height: 100%; display: block; }
      .card-art.mobile { display: none; }
      .card-art img { width: 100%; height: 100%; display: block; }

      @media (max-width: 760px) {
        .home-base.desktop { display: none; }
        .home-base.mobile { display: block; }

        .industries-overlay {
          left: 0;
          right: 0;
          top: 3464px;
          height: 1651px;
        }

        .industries-intro-art.desktop { display: none; }
        .industries-intro-art.mobile {
          display: block;
          left: 15px;
          top: 15px;
          width: 360px;
          height: 249px;
        }

        .stack-track {
          left: 98px;
          top: 241px;
          width: 165px;
          height: calc(100% - 241px);
        }

        .stack-card {
          top: 241px;
          margin-top: var(--step-m, 0px);
          width: var(--w-m, 165px);
          height: var(--h-m, 493px);
        }

        .card-art.desktop { display: none; }
        .card-art.mobile { display: block; }
      }
    </style>
  </head>
  <body>
    <main class="home-overlay-root" aria-label="Homepage 9h41">
      <img class="home-base desktop" src="/assets/images/home-desktop.png" alt="Accueil 9h41" />
      <img class="home-base mobile" src="/assets/images/home-mobile.png" alt="Accueil 9h41 version mobile" />

      <section class="industries-overlay" aria-label="Industries">
        <div class="industries-grid">
          <div class="industries-intro-art desktop"><img src="/assets/images/industries-intro-desktop.png" alt="Industries" /></div>
          <div class="industries-intro-art mobile"><img src="/assets/images/industries-intro-mobile.png" alt="Industries" /></div>
          <div class="stack-track">
            {{ content | safe }}
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
