<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = fullTitle or ((title ~ ' | ' ~ site.name) if title else site.name) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.domain }}{{ page.url }}">
<meta name="robots" content="{{ site.robots or 'index,follow' }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.domain }}{{ page.url }}">
<meta property="og:image" content="{{ site.domain }}{{ seoImage or site.socialImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ description or site.description }}">
<meta name="twitter:image" content="{{ site.domain }}{{ seoImage or site.socialImage }}">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/images/favicon-192.png">
<link rel="stylesheet" href="/assets/css/styles.css">
<script>
  // home page from 769px: its 1440px design is scaled to the window (zoom), like the Wix site
  (function () {
    function setZoom() { document.documentElement.style.setProperty('--home-zoom', document.documentElement.clientWidth / 1440); }
    setZoom();
    addEventListener('resize', setZoom);
  })();
</script>
